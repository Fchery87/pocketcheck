{
  "name": "pocketcheck",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "vp check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vp test run --exclude 'tests/integration/**'",
    "test:integration": "vp test run tests/integration",
    "db:migrate": "node scripts/migrate.mjs",
    "data:import": "node --experimental-strip-types scripts/data/import.ts",
    "data:schedule": "node --experimental-strip-types scripts/data/schedule.ts",
    "model:fit": "node --experimental-strip-types scripts/model/fit.ts",
    "model:evaluate": "node --experimental-strip-types scripts/model/evaluate.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "^24.11.0"
  }
}
