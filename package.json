{
  "name": "pocketcheck",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "vp check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vp test run",
    "test:integration": "vp test run tests/integration",
    "db:migrate": "node scripts/migrate.mjs",
    "test:e2e": "echo \"Playwright is added in the research-flow task\" && exit 0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "^24.11.0"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
