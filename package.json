{
  "name": "pocketcheck",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "vp check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types scripts/unit-test.ts",
    "test:integration": "vp test run tests/integration",
    "db:migrate": "node scripts/migrate.mjs",
    "data:import": "node --experimental-strip-types scripts/data/import.ts",
    "data:schedule": "node --experimental-strip-types scripts/data/schedule.ts",
    "data:injuries": "node --experimental-strip-types scripts/data/injuries.ts",
    "data:play-by-play": "node --experimental-strip-types scripts/data/play-by-play.ts",
    "model:fit": "node --experimental-strip-types scripts/model/fit.ts",
    "model:evaluate": "node --experimental-strip-types scripts/model/evaluate.ts",
    "model:release": "node --experimental-strip-types scripts/model/release.ts",
    "test:e2e": "node --experimental-strip-types scripts/browser-test.ts",
    "verify": "node --experimental-strip-types scripts/verify.ts",
    "verify:database": "node --experimental-strip-types scripts/verify.ts --database",
    "start": "node --experimental-strip-types --env-file=.env scripts/start.ts"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "melt": "^0.44.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "^24.11.0"
  }
}
