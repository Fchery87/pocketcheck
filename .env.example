# Copy to .env and fill only the values you have. Never commit .env.
# Dev and preview read .env automatically. The Node server needs: node --env-file=.env build

# Neon connection for the research journal. Required: the app does not fall back to memory.
# The integration tests write to this database too, so use a disposable one.
DATABASE_URL=

# Optional AI providers. Leave blank until the provider settings task.
THECLAWBAY_API_KEY=
DEEPSEEK_API_KEY=

# Local production bind. The Node adapter reads HOST and PORT.
HOST=127.0.0.1
PORT=3000
