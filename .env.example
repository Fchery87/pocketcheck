# Copy to .env and fill only the values you have. Never commit .env.
# Dev and preview read .env automatically. The Node server needs: node --env-file=.env build

# Neon connection for the research journal. Required: the app does not fall back to memory.
DATABASE_URL=

# Required explicitly for npm run verify:database. Use disposable test storage.
# Each test file migrates a generated schema and drops only that schema.
# Integration tests do not load .env or fall back to DATABASE_URL.
TEST_DATABASE_URL=

# Optional: identify yourself to api.weather.gov, which asks for contact details.
NWS_USER_AGENT=

# Optional AI providers. Server-only: Settings shows whether each is set, never the key.
# With neither, choose the fixture drafter in Settings.
THECLAWBAY_API_KEY=
DEEPSEEK_API_KEY=

# Local production bind. The Node adapter reads HOST and PORT.
HOST=127.0.0.1
PORT=3000
