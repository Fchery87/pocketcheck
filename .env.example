# Copy to .env and fill only the values you have. Never commit .env.
# Dev and preview read .env automatically. The Node server needs: node --env-file=.env build

# Neon connection for the research journal. Required: the app does not fall back to memory.
DATABASE_URL=

# Required explicitly for npm run verify:database. Use disposable test storage.
# Each test file migrates a generated schema and drops only that schema.
# Integration tests do not load .env or fall back to DATABASE_URL.
TEST_DATABASE_URL=

# Optional: identify yourself to api.weather.gov, which asks for contact details.
NWS_USER_AGENT=

# Optional AI providers. Server-only: Settings shows whether each is set, never the key.
# With neither, choose the fixture drafter in Settings.
THECLAWBAY_API_KEY=
DEEPSEEK_API_KEY=

# Local production bind. The Node adapter reads HOST and PORT.
HOST=127.0.0.1
PORT=3000

# Optional access protection. Generate a fresh random secret, not a password:
# node -p 'require("node:crypto").randomBytes(32).toString("hex")'
# Sessions expire after 12 hours. Changing the secret invalidates existing sessions.
POCKETCHECK_ACCESS_SECRET=

# Required to bind beyond loopback WITHOUT access protection. Unsafe by design.
# Anyone who can reach this server can read, export, and change your journal.
POCKETCHECK_UNSAFE_LAN=

# Separate immutable authorization. Leave unset until prospective evidence passes.
POCKETCHECK_RELEASE_ATTESTATION=

# npm start serves plain HTTP and ignores forwarded protocol headers from clients.
# A login cookie on HTTP provides no network confidentiality. Use a trusted LAN.
# For HTTPS use a trusted TLS proxy and adapter deployment with an explicit HTTPS
# ORIGIN. Never trust client-supplied forwarding headers on a public interface.
