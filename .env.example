# Copy to .env and fill only the values you have. Never commit .env.
# Task 1 does not read these. Later tasks use them for local integrations.

# Neon development connection. Use a Free-plan disposable database.
DATABASE_URL=

# Optional AI providers. Leave blank until the provider settings task.
THECLAWBAY_API_KEY=
DEEPSEEK_API_KEY=

# Local production bind. The Node adapter reads HOST and PORT.
HOST=127.0.0.1
PORT=3000
