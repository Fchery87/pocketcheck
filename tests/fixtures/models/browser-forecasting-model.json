  "featureDefinitions": [
    {
      "name": "home_prior_margin",
      "description": "Home team's recency-weighted point margin in games strictly before this kickoff, shrunk toward 0. See featureParameters."
    },
    {
      "name": "away_prior_margin",
      "description": "Away team's recency-weighted point margin in games strictly before this kickoff, shrunk toward 0."
    },
    {
      "name": "home_prior_points_for",
      "description": "Home team's recency-weighted points scored in strictly prior games, shrunk toward the league mean of strictly prior games."
    },
    {
      "name": "away_prior_points_for",
      "description": "Away team's recency-weighted points scored, shrunk toward the league mean."
    },
    {
      "name": "home_prior_points_against",
      "description": "Home team's recency-weighted points allowed, shrunk toward the league mean."
    },
    {
      "name": "away_prior_points_against",
      "description": "Away team's recency-weighted points allowed, shrunk toward the league mean."
    },
    {
      "name": "home_rest_days",
      "description": "Days since the home team's previous kickoff in the same season. 7 for its first game of a season."
    },
    {
      "name": "away_rest_days",
      "description": "Days since the away team's previous kickoff in the same season. 7 for its first game of a season."
    },
    {
      "name": "home_qb_share",
      "description": "Share of the home team's last 8 games started by this game's starting quarterback. When the starter is not known, the team's most frequent recent starter. 1 before a team's first game."
    },
    {
      "name": "away_qb_share",
      "description": "The same quarterback share for the away team."
    },
    {
      "name": "home_qb_rating",
      "description": "Recency-weighted team margin in every strictly earlier game the home starter started, for any team, shrunk toward qbReplacement. The same starter rule as home_qb_share."
    },
    {
      "name": "away_qb_rating",
      "description": "The same quarterback rating for the away team's starter."
    },
    {
      "name": "home_indicator",
      "description": "1 when the game is not neutral, otherwise 0."
    },
    {
      "name": "home_qb_efficiency",
      "description": "Home starter's recency-weighted EPA per dropback plus completion percentage over expected, shrunk toward qbReplacement by qbPriorWeight. Uses only plays from games eligible before the cutoff."
    },
    {
      "name": "away_qb_efficiency",
      "description": "The same quarterback efficiency for the away starter."
    },
    {
      "name": "home_offense_epa",
      "description": "Home offense's opponent-adjusted, recency-weighted EPA per play, carried from last season at seasonCarry."
    },
    {
      "name": "away_offense_epa",
      "description": "The same offensive efficiency for the away team."
    },
    {
      "name": "home_defense_epa",
      "description": "Home defense's opponent-adjusted EPA per play allowed, negated so higher is better."
    },
    {
      "name": "away_defense_epa",
      "description": "The same defensive efficiency for the away team."
    },
    {
      "name": "pace_seconds",
      "description": "Combined seconds per offensive play for both teams. Lower is faster."
    },
    {
      "name": "pass_rate_over_expected",
      "description": "Combined pass rate over expected for both teams."
    },
    {
      "name": "rest_differential",
      "description": "Home rest days minus away rest days."
    },
    {
      "name": "short_week",
      "description": "1 when either team is on fewer than 6 days of rest."
    },
    {
      "name": "off_bye",
      "description": "1 when either team is coming off 13 or more days of rest."
    },
    {
      "name": "home_offense_pass_epa",
      "description": "Home offense's opponent-adjusted passing EPA per play, recency-weighted and shrunk toward the league mean. Carried from last season at seasonCarry."
